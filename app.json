{
  "expo": {
    "name": "AD Motors",
    "slug": "admotors",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#1a1a1a",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a1a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "AD Motors necesita acceso a tus fotos para seleccionar imágenes de vehículos.",
          "cameraPermission": "AD Motors necesita acceso a la cámara para tomar fotos de vehículos."
        }
      ]
    ],
    "android": {
      "package": "com.admotors.app",
      "versionCode": 1,
      "icon": "./assets/icon.png",
      "splash": {
        "image": "./assets/icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#1a1a1a"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1a1a1a"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "description": "Gestión de vehículos con imágenes en la nube - Android"
  }
}